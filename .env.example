# Legal Metrology Online Verification System (e-Maanak) Environment Configuration
# Default configuration runs fully autonomously in browser with seed data and offline sync.
# Supabase and Gemini are optional enhancements.

# Supabase Configuration (Optional - PostgreSQL persistence & Storage)
# IMPORTANT: Never put SUPABASE_SERVICE_ROLE_KEY here. Only public anon credentials.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Google Gemini API Key for intelligent document scrutiny assistance
# Free-tier only; system degrades gracefully if absent.
VITE_GEMINI_API_KEY=

# Application Host Base URL
VITE_APP_URL=http://localhost:5173
